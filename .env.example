# ── Kimiko AI Environment Configuration ──

# Environment
KIMIKO_ENV=development

# API
KIMIKO_API_HOST=0.0.0.0
KIMIKO_API_PORT=8000
KIMIKO_API_SECRET_KEY=change-me-in-production
KIMIKO_API_DEBUG=true

# Ollama (host install; 127.0.0.1 avoids stale IPv6 listeners on Windows)
KIMIKO_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Used by docker-compose to reach a host-run Ollama from inside containers.
KIMIKO_DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
KIMIKO_DEFAULT_MODEL=qwen3.5:4b
KIMIKO_EMBEDDING_MODEL=embeddinggemma-2:270m

# Redis
KIMIKO_REDIS_URL=redis://localhost:6379/0
KIMIKO_CELERY_BROKER_URL=redis://localhost:6379/1

# PostgreSQL
POSTGRES_USER=kimiko
POSTGRES_PASSWORD=change_this_secret_password
KIMIKO_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/kimiko

# Qdrant
KIMIKO_QDRANT_URL=http://localhost:6333
KIMIKO_QDRANT_COLLECTION=memories
KIMIKO_VECTOR_SIZE=768

# Memory
KIMIKO_SESSION_TTL_SECONDS=3600
KIMIKO_SUMMARY_TTL_SECONDS=86400
KIMIKO_CONVERSATION_SUMMARY_THRESHOLD=20

# Rate Limiting
KIMIKO_RATE_LIMIT_RPM=60

# Token Budgets (defaults per model in token_manager)
KIMIKO_MAX_CONTEXT_TOKENS=8192
